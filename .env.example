APP_ENV=local
HOST=127.0.0.1
PORT=4173
SQLITE_PATH=oficina.db
SESSION_TTL_SECONDS=28800
PASSWORD_HASH_ITERATIONS=260000
MIN_USER_PASSWORD_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
DEFAULT_ADMIN_NAME=MASTER
DEFAULT_ADMIN_USERNAME=master
DEFAULT_ADMIN_EMAIL=master@oficina.local
DEFAULT_ADMIN_PASSWORD=Master@123
BILLING_PROVIDER=manual
PUBLIC_APP_URL=http://127.0.0.1:4173

# Em staging/production, altere DEFAULT_ADMIN_USERNAME, DEFAULT_ADMIN_EMAIL e use DEFAULT_ADMIN_PASSWORD com 12+ caracteres.

# Pagamentos reais. Obrigatório em produção e, se usado online, o webhook secret precisa ter 32+ caracteres.
# BILLING_PROVIDER=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# Banco gerenciado para staging/produção.
# DATABASE_URL=postgresql://user:password@host:5432/oficina_pro
